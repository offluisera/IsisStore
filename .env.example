# ==========================================
# ISIS STORE — VARIÁVEIS DE AMBIENTE (.env.example)
# NUNCA commitar arquivos .env ou .env.local com segredos reais!
# ==========================================

# Aplicação
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Públicas - Client Side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Supabase (Privada - SERVER SIDE ONLY - NUNCA expor no browser)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Mercado Pago Gateway (Adapter de Pagamento)
MERCADOPAGO_ACCESS_TOKEN=TEST-your-mercadopago-access-token
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=TEST-your-mercadopago-public-key
MERCADOPAGO_WEBHOOK_SECRET=your-mercadopago-webhook-secret

# Segurança do Painel — Senha Master para Alteração de Credenciais
ADMIN_MASTER_PASSWORD=sua-senha-master-aqui

# InfinitePay Gateway (Opcional — configuração dinâmica via Painel Admin /admin/gateways com Senha Master)
# INFINITEPAY_HANDLE=isisstore
# INFINITEPAY_CLIENT_ID=your-infinitepay-client-id
# INFINITEPAY_CLIENT_SECRET=your-infinitepay-client-secret

