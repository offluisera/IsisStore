# ==============================================================================
# ISIS STORE — VARIÁVEIS DE AMBIENTE PARA PRODUÇÃO (.env.production.example)
# ==============================================================================
# ATENÇÃO: NUNCA versione credenciais ou chaves reais no controle de código (Git)!
# Preencha estas variáveis no painel de ambiente do provedor (Vercel, Railway, Coolify, VPS, etc.).
# ==============================================================================

# 1. Configurações Canônicas da Aplicação e SEO
# URL pública do domínio de produção com protocolo HTTPS e sem barra no final.
NEXT_PUBLIC_SITE_URL=https://isisstore.com.br
NEXT_PUBLIC_APP_URL=https://isisstore.com.br
NODE_ENV=production

# 2. Supabase Cloud (Produção)
# Disponíveis em: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto-prod.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...sua-anon-key-de-producao...
# SERVER-SIDE ONLY: Chave de privilégio de serviço. NUNCA exponha no client-side ou com NEXT_PUBLIC_!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...sua-service-role-key-de-producao...

# 3. Gateway de Pagamento — Mercado Pago (Produção)
# Disponíveis em: Mercado Pago Developers -> Suas Aplicações -> Credenciais de Produção
# Formato de produção: APP_USR-xxxx... (NUNCA utilize chaves de teste TEST-xxxx em ambiente real)
MERCADOPAGO_ACCESS_TOKEN=APP_USR-seu-access-token-de-producao
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=APP_USR-sua-public-key-de-producao
# Secret para validação criptográfica HMAC SHA-256 de webhooks recebidos em /api/webhooks/mercadopago
MERCADOPAGO_WEBHOOK_SECRET=seu-webhook-secret-do-mercado-pago

# 4. Segurança do Painel Administrativo
# Senha mestra exigida pelo backend para salvar ou alterar credenciais sensíveis em /admin/gateways
ADMIN_MASTER_PASSWORD=DefinaUmaSenhaForteExclusivaDeAdmin!@#2026

# 5. Gateway Alternativo — InfinitePay (Produção - Opcional)
# Pode ser configurado via variáveis de ambiente ou salvo criptografado no banco via /admin/gateways
# INFINITEPAY_HANDLE=isisstore
# INFINITEPAY_CLIENT_ID=seu-client-id-infinitepay
# INFINITEPAY_CLIENT_SECRET=seu-client-secret-infinitepay

# 6. Observabilidade e Monitoramento (Opcional)
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# SENTRY_DSN=https://xxxxxxxx@sentry.io/xxxxxx
